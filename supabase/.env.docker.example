# PostgreSQL Configuration
POSTGRES_PASSWORD=
POSTGRES_DB=

# JWT Secret - MUST be changed for local development
# Generate a new one with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRY=3600

# Anon Key - JWT token for unauthenticated access
# This should be generated locally, not shared
ANON_KEY=

# Service Key - JWT token for service role operations
# This should be generated locally, not shared
SERVICE_KEY=

# API Configuration
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SUPABASE_PUBLIC_URL=http://localhost:8000

# Site URL (your Next.js app)
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# External Hosts (allow Envoy gateway and app origin)
MAILER_EXTERNAL_HOSTS=localhost:8000,localhost:3000

# Auth Configuration
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# SMTP Configuration (optional for local dev since we auto-confirm)
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IMPORTANT: POSTGRES_PASSWORD should only contain alphanumeric characters
# Special characters (@:/?#%) are not URL-encoded in the connection string
# and will cause PostgreSQL connection failures