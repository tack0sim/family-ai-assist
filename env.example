# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────

# Full public URL of the app (used in emails and OAuth redirects)
# Local:      http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_BASE_URL=

# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────

# REST API URL
# Local (Docker PostgREST): http://localhost:3001
# Production (Supabase cloud): https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key – safe to expose to the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anon key (same value as the publishable key, kept for legacy SDK compat)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key – NEVER expose to the browser; server-only
SUPABASE_SERVICE_ROLE_KEY=

# Database password (used by migrations and local docker-compose)
SUPABASE_DB_PASSWORD=

# OAuth redirect URL for Supabase Auth
# Local:      http://localhost:3000/auth/callback
# Production: https://yourdomain.com/auth/callback
SUPABASE_CALLBACK_URL=

# ─────────────────────────────────────────────
# Google OAuth (Supabase Auth External Provider)
# ─────────────────────────────────────────────

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Redis  (rate-limiting for AI chat)
# ─────────────────────────────────────────────

# Local (Docker):     redis://localhost:6379
# Production (Upstash/Redis Cloud): rediss://<user>:<pass>@<host>:<port>
REDIS_URL=

# ─────────────────────────────────────────────
# OpenAI  (AI Assistant)
# ─────────────────────────────────────────────

OPENAI_API_KEY=

# ─────────────────────────────────────────────
# Resend  (transactional email)
# ─────────────────────────────────────────────

RESEND_API_KEY=

# "From" address shown to recipients
# Example: Family Assistant <noreply@yourdomain.com>
RESEND_FROM_EMAIL=